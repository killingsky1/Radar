{"amount_max": null, "amount_min": null, "badge": "officiel", "category": "gouvernement", "checks": {"champs_requis": true, "dates_coherentes": true, "decision_lue": true, "domaine_officiel": true, "empreinte": true, "fourchette_plausible": true, "source_connue": true, "source_officielle": true, "symboles_valides": true, "vote_lu": true}, "collected_at": "2026-10-03T00:12:28+00:00", "confirmations": [], "currency": "USD", "data": {"bas": 3.5, "decision": "maintenu", "haut": 3.75, "pas": null, "resume": "The Federal Open Market Committee approved the following statement for release by a 9 - 3 vote: The Committee decided to maintain the target range for the federal funds rate at 3-1/2 to 3-3/4 percent, in support of the Federal Reserve's dual mandate. The Committee is continuing its policy of maintaining ample reserves in the banking system. Economic activity is expanding at a solid pace despite elevated uncertainty that owes, in part, to the conflict in the Middle East. Productivity growth and capital investment are strong. Job gains have kept pace with the workforce, and the unemployment rate has changed little. Inflation remains elevated relative to the Committee's 2 percent goal, in part ", "titre_officiel": "Federal Reserve issues FOMC statement", "vote": "9-3"}, "direction": 0, "entities": ["Federal Reserve (FOMC)"], "id": "fed:monetary20260729a", "kind": "decision_taux", "notes": [], "occurred_on": "2026-07-29", "official_id": "monetary20260729a", "official_url": "https://www.federalreserve.gov/newsevents/pressreleases/monetary20260729a.htm", "parser_version": "banques-3", "published_on": "2026-07-29", "sha256": "7f51525111d92b62486394aea7caaf4574e88137b355e470eaaeb3e89e217b4f", "source": "fed", "tickers": [], "title": "Fed : taux directeur maintenu entre 3,5 % et 3,75 % (vote : 9 pour, 3 contre)"}
