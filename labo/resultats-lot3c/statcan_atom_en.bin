    </summary>
  </entry>
  <entry>
    <title type="xhtml">
      <div xmlns="http://www.w3.org/1999/xhtml">Oilseed crushing statistics, <span class="refper">July 2026</span></div>
    </title>
    <link href="https://www.statcan.gc.ca/daily-quotidien/260828/dq260828d-eng.htm"></link>
