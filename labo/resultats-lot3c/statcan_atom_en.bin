  <entry>
    <title type="xhtml">
      <div xmlns="http://www.w3.org/1999/xhtml">Canada's balance of international payments, <span class="refper">second quarter 2026</span></div>
    </title>
    <link href="https://www.statcan.gc.ca/daily-quotidien/260827/dq260827a-eng.htm"></link>
    <id>https://www.statcan.gc.ca/daily-quotidien/260827/dq260827a-eng.htm</id>
