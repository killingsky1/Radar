  <entry>
    <title type="xhtml">
      <div xmlns="http://www.w3.org/1999/xhtml">Railway carloadings, <span class="refper">July 2026</span></div>
    </title>
    <link href="https://www.statcan.gc.ca/daily-quotidien/260928/dq260928a-eng.htm"></link>
    <id>https://www.statcan.gc.ca/daily-quotidien/260928/dq260928a-eng.htm</id>
    <updated>2026-09-28T08:30:00-04:00</updated>
    <summary type="xhtml">
      <div xmlns="http://www.w3.org/1999/xhtml">In July, Canadian railways transported 31.7 million tonnes of freight, up 2.6% from July 2025, marking the fourth straight month of year-over-year increases.</div>
    </summary>
  </entry>
  <entry>
    <title type="xhtml">
      <div xmlns="http://www.w3.org/1999/xhtml">Food services and drinking places, <span class="refper">July 2026</span></div>
