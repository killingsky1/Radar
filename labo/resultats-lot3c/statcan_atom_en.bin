    <updated>2026-07-31T08:30:00-04:00</updated>
    <summary type="xhtml">
      <div xmlns="http://www.w3.org/1999/xhtml">Primary energy production increased 2.7% year over year in May to 2.0&#160;million gigajoules, with gains in five&#160;of six&#160;subsectors. </div>
    </summary>
  </entry>
  <entry>
    <title type="xhtml">
      <div xmlns="http://www.w3.org/1999/xhtml">Screened passenger traffic at Canadian airports, <span class="refper">June 2026</span></div>
    </title>
    <link href="https://www.statcan.gc.ca/daily-quotidien/260731/dq260731c-eng.htm"></link>
