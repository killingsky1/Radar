    </summary>
  </entry>
  <entry>
    <title type="xhtml">
      <div xmlns="http://www.w3.org/1999/xhtml">Gross domestic product by industry, <span class="refper">May 2026</span></div>
    </title>
    <link href="https://www.statcan.gc.ca/daily-quotidien/260731/dq260731a-eng.htm"></link>
