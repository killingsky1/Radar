<?xml version="1.0" encoding="UTF-8"?>
<rss version="2.0">
    <channel>
        <title>Gazette du Canada - Partie II</title>
        <link>https://gazette.gc.ca/rss/p2-fra.xml</link>
        <description>La Partie II de la Gazette du Canada comprend une édition publiée toutes les deux semaines, soit le mercredi; un index codifié trimestriel, publié tous les trois mois; et des éditions spéciales, publiées au besoin  une date autre que la date de publication de l'édition régulière lorsque des circonstances spéciales ou des exigences prévues par la loi en justifient la publication....</description>
        <pubDate>Wed, 21 Mar 2018 09:00:00 -0500</pubDate>
