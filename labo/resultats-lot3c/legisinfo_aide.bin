    <header>
        <h1>Help</h1>
    </header>

    <section>
        <div class="row" data-spy="scroll" data-target="#help-menu" data-bs-offset="0">
    <div class="col-md-4 side order-2">
        <a class="sr-only" href="#content">Skip the table of contents</a>
        <div id="help-menu">
            <div class="clearfix"></div>
            <h2 id="help-menu-heading">Table of contents</h2>
            <ul class="main-list">
                <li>
                    <a href="#using" class="nav-link">Using LEGISinfo</a>
                    <ul>
                        <li>
                            <a href="#titles" class="nav-link" aria-label="Go to the 'Main pages and features' section on this page">Main pages and features</a>
                            <ul>
                                <li><a href="#overview" class="nav-link" aria-label="Go to the 'Overview' section on this page">Overview</a></li>
                                <li><a href="#bills" class="nav-link" aria-label="Go to the 'Bills' section on this page">Bills</a></li>
