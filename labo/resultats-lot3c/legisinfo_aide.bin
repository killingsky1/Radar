                            <a href="#symbols" class="nav-link" aria-label="Go to the 'Icons' section on this page">Icons</a>
                        </li>
                        <li>
                            <a href="#searching" class="nav-link" aria-label="Go to the 'Searching' section on this page">Searching</a>
                            <ul>
                                <li><a href="#keywords" class="nav-link" aria-label="Go to the 'Keyword searches' section on this page">Keyword searches</a></li>
                                <li><a href="#refiners" class="nav-link" aria-label="Go to the 'Using refiners' section on this page">Using refiners</a></li>
                            </ul>
                        </li>
                        <li><a href="#open-data" class="nav-link" aria-label="Go to the 'Open data' section on this page">Open data</a></li>
                    </ul>
                </li>
                <li>
                    <a href="#understanding-legislation" class="nav-link" aria-label="Go to the 'Understanding legislation and bills' section on this page">Understanding legislation and bills</a>
                    <ul>
                        <li><a href="#legislative-process" class="nav-link" aria-label="Go to the 'Legislative process' section on this page">Legislative process</a></li>
                        <li>
                            <a href="#types-of-bills" class="nav-link" aria-label="Go to the 'Types of bills' section on this page">Types of bills</a>
                            <ul>
                                <li><a href="#public-bills" class="nav-link" aria-label="Go to the 'Public bills' section on this page">Public bills</a></li>
                                <li><a href="#private-bills" class="nav-link" aria-label="Go to the 'Private bills' section on this page">Private bills</a></li>
                            </ul>
                        </li>
                        <li><a href="#bill-numbering" class="nav-link" aria-label="Go to the 'Bill numbering' section on this page">Bill numbering</a></li>
                    </ul>
                </li>
                <li>
