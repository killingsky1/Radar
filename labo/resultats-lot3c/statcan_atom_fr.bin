    <link href="https://www.statcan.gc.ca/daily-quotidien/260921/dq260921e-fra.htm"></link>
    <id>https://www.statcan.gc.ca/daily-quotidien/260921/dq260921e-fra.htm</id>
    <updated>2026-09-21T08:30:00-04:00</updated>
    <summary type="xhtml">
      <div xmlns="http://www.w3.org/1999/xhtml">Il est maintenant possible de consulter les donn&#233;es de juillet de l'Enqu&#234;te mensuelle sur la production min&#233;rale et de l'Enqu&#234;te mensuelle sur les usines de fusion et d'affinage de m&#233;taux.</div>
    </summary>
  </entry>
  <entry>
    <title type="xhtml">
      <div xmlns="http://www.w3.org/1999/xhtml">Enqu&#234;te mensuelle sur le transport et l'entreposage d'&#233;nergie, <span class="refper">juillet 2026</span></div>
