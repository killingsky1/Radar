    <id>https://www.statcan.gc.ca/daily-quotidien/260828/dq260828e-fra.htm</id>
    <updated>2026-08-28T08:30:00-04:00</updated>
    <summary type="xhtml">
      <div xmlns="http://www.w3.org/1999/xhtml">Il est maintenant possible de consulter les estimations mensuelles des ouvertures et des fermetures d'entreprises pour le mois de mai&#160;2026.</div>
    </summary>
  </entry>
  <entry>
    <title type="xhtml">
      <div xmlns="http://www.w3.org/1999/xhtml">Indice des prix des machines et du mat&#233;riel, <span class="refper">juin 2026</span></div>
    </title>
    <link href="https://www.statcan.gc.ca/daily-quotidien/260828/dq260828f-fra.htm"></link>
    <id>https://www.statcan.gc.ca/daily-quotidien/260828/dq260828f-fra.htm</id>
