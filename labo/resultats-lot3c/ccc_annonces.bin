<style id="wp-custom-css">
/* SHIM - jetMenu variable from jetMenu 3.0.1.1 that is not being applied in jetMenu 3.0.2.1.
This fixes an issue with positioning the mega menu dropdown on desktop, putting it back where we want it. 2026-07-21 KL 
Update 2026-08-26 - JetMenu has been updated, this is unnecessary now. Keeping it commented out here as a reminder in case the issue comes back. -KL
*/
/*
 * .jet-mega-menu.jet-mega-menu--layout-horizontal .jet-mega-menu-mega-container__inner {
	transform: translateX(var(--jmm-submenu-delta-x-offset, 0))
}
*/

/* Utility to prevent text wrapping (TODO: move this to theme files -KL) */
.nowrap {
	white-space: nowrap;
}


.elementor-widget-heading .elementor-heading-title[class*=elementor-size-]>a:hover, 
.elementor-widget-heading .elementor-heading-title[class*=elementor-size-]>a:focus 
{
	color: #007FAD;	
}

span.jet-search-filter__submit-text {
	width: 1px; 
	height: 1px;
  overflow: hidden;
	display: inline-block;
}

/*/// 
Abbreviating language toggle 
(visually only) 
2026.02 -KL
//// */
header.elementor-location-header .wpml-ls-native {
	visibility:hidden;
	width: 2.5em;
	position:relative;
	padding: 0 .25em;
}
header.elementor-location-header .wpml-ls-native:after {
	text-transform: uppercase;
	display: inline-block;
	visibility: visible;
	position:absolute;
	width: 2.5em;
	left: 0;
	text-align:center;
	font-size: 16px;
}
header.elementor-location-header .wpml-ls-native[lang='fr']:after {
	content: 'Fr';
}
header.elementor-location-header .wpml-ls-native[lang='en']:after {
	content: 'En';
}

/* Shifting language toggle up a bit on mobile */
@media (max-width: 1024px) {
	header.elementor-location-header .wpml-ls-menu-item a 	{
		margin-top: -12px;
	}
}

/*  ///////////
Some extra help for the 2026.02 mega menu revamp -KL 
///////////////
*/

.elementor-widget-jet-mega-menu.ccc-main-nav-mobile-mega-menu {
/* 	top: -55px; */
	width: auto!important;
/* 	margin-left: 10px; */
}

.jet-mega-menu.jet-mega-menu--layout-horizontal .jet-mega-menu-mega-container__inner {
    padding-left: 0;
    padding-right: 0;
    padding-top: 0;
    padding-bottom: 0;
		margin-top: 39px; 
}

.jet-mega-menu-item--top-level .jet-mega-menu-item__dropdown {
    margin-top: 0px;
    transition: all 0.3s ease-out allow-discrete;
}

.jet-mega-menu-item--top-level.jet-mega-menu-item--hover .jet-mega-menu-item__dropdown {
    transform: rotate(180deg);
}

.jet-mega-menu .jet-mega-menu-item__inner {
    border-bottom: 3px solid transparent;
    padding-bottom: 10px;
}
.jet-mega-menu .jet-mega-menu-item__inner:hover, 
.jet-mega-menu .jet-mega-menu-item__inner:focus, 
.jet-mega-menu-item--top-level.jet-mega-menu-item--hover .jet-mega-menu-item__inner {
    border-bottom: 3px solid #C42025;
}

/* //// Mega menu close button //// */

.jet-mega-menu-mega-container__inner .ccc-mega-close .elementor-button  {
	padding-right: 2em; 
	position: relative;
	margin-right: 1em;
}
.jet-mega-menu-mega-container__inner .ccc-mega-close .elementor-button  .elementor-button-text:after {
	content: 'ⓧ';
	display: inline-block;
	position: absolute; 
	right: .25em;
	width: 1.5em;
}


/* //// Mega menu animation //// */

/* mm outer */
li.jet-mega-menu-item  
div.jet-mega-menu-mega-container {
		transition: all 0.3s ease-out allow-discrete;
/* 	transform: translateY(-5%); */
/* 	opacity:0; */
	max-height: 0;
	transform: scaleY(0)!important;
}

/* mm outer — open */
li.jet-mega-menu-item.jet-mega-menu-item--hover 
div.jet-mega-menu-mega-container {
	animation-name: slide-down;
/* 	transform: translateY(0); */
	transform: scaleY(1)!important;
	max-height: 100%;
}


@keyframes slide-down {
	from {
/*         opacity: 0; */
		transform: scaleY(0)!important;
/*         transform: translateY(-5%); /* Start x% of its own height above its final position */ */
    }
    to {
/*         opacity: 1; */
			transform: scaleY(1)!important;
/*         transform: translateY(0); /* End at its normal position */ */
    }
}

/* adjustment for the script-appended (PDF) string for PDF links, when the link is an Elementor list item: */
.elementor-icon-list-item a[href$=".pdf"] span:last-child {
	padding-right: .25em;
}

/* KNOWLEDGE BASE numbering (for root page pillar buckets) */
#ccc-kbase-root-menu  {
	counter-reset: pillar-ordering;
}
#ccc-kbase-menu-counter-wrapper:before {
	counter-increment: pillar-ordering;
	font-weight:600;
	font-size: 42px;
	color: #fff;
	content: counter(pillar-ordering); 
	    min-width: 65px;
    min-height: 65px;
    max-width: 65px;
    max-height: 65px;
	text-align:center;
	position:absolute;
	z-index:1;
	background: #007FAD;
}

/*//// ELEM. EDITOR temp. fixes //////
(TODO: should move these to a stylesheet only loaded in the editor, for optimization)  */
/* Forces normal, predictable spacing for standard paragraphs */
.e-embedded-document-active .elementor-widget-text-editor p {
    margin-bottom: 1.2em!important; 
}

</style>
