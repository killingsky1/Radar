<![endif]-->
<div class="abe-column-block" id="abe-column-block-64e15064-a1f1-4d5b-9b3a-0a34fe1eb9db" style="width: 100%; box-sizing: border-box; display: inline-block; font-size: 16px; vertical-align: top;" data-block-type="FancyBlockColumn" data-block-id="">
<div class="abe-column-block-padding" id="abe-column-block-64e15064-a1f1-4d5b-9b3a-0a34fe1eb9db-padding" style="padding: 15px;">
<table style="table-layout: fixed; overflow-wrap: break-word; word-wrap: break-word; text-align: left; -webkit-text-size-adjust: 100%; -ms-text-size-adjust: 100%; border-spacing: 0; mso-table-lspace: 0pt; mso-table-rspace: 0pt;" role="presentation" border="0" width="100%" cellspacing="0" cellpadding="0" align="center">
<tbody>
<tr>
<td style="-webkit-text-size-adjust: 100%; -ms-text-size-adjust: 100%; mso-table-lspace: 0pt; mso-table-rspace: 0pt;">
<h1 style="-webkit-text-size-adjust: 100%; -ms-text-size-adjust: 100%; text-align: right; font-size: 18px; font-family: 'times new roman', times; margin-top: 0px; margin-bottom: 15px; line-height: 120%;" align="right"><font size="5">Cargo Systems Messaging Service</font></h1>
<div class="govd_hr">
<div class="govd_hr_inner"><hr /></div>
</div>
<h2 style="-webkit-text-size-adjust: 100%; -ms-text-size-adjust: 100%; line-height: 140%; font-family: 'times new roman', times; font-size: 20px; margin-top: 15px; margin-bottom: 15px;">CSMS # 69896141 - SMS Option Now Available for ACE Portal Login Authentication</h2>
<div class="govd_hr">
<div class="govd_hr_inner"><hr /></div>
</div>
<p style="-webkit-text-size-adjust: 100%; -ms-text-size-adjust: 100%; line-height: 140%; font-family: 'times new roman', times; font-size: 15px; margin-top: 15px; margin-bottom: 15px;"><font size="3">On <span style="margin: 0px; padding: 0px;">S<font face="times new roman,times">eptember</font></span><font face="times new roman,times" style="font-size: 11pt; color: windowtext;"><span style="margin: 0px; padding: 0px;">&nbsp;12,&nbsp;</span><span style="margin: 0px; padding: 0px;">2026</span><span style="margin: 0px; padding: 0px;">, U.S. Customs and Border Protection (CBP)</span><span style="margin: 0px; padding: 0px;">&nbsp;</span><span style="margin: 0px; padding: 0px;">enhanced</span><span style="margin: 0px; padding: 0px;">&nbsp;</span><span style="margin: 0px; padding: 0px;">A</span><span style="margin: 0px; padding: 0px;">utomated Commercial Environment (ACE)</span><span style="margin: 0px; padding: 0px;">&nbsp;Portal account&nbsp;</span><span style="margin: 0px; padding: 0px;">login&nbsp;</span><span style="margin: 0px; padding: 0px;">security&nbsp;</span><span style="margin: 0px; padding: 0px;">by adding&nbsp;</span><span style="margin: 0px; padding: 0px;">Short Message Service (SMS) as a</span><span style="margin: 0px; padding: 0px;">&nbsp;</span><span style="margin: 0px; padding: 0px;">multifactor&nbsp;</span><span style="margin: 0px; padding: 0px;">login&nbsp;</span><span style="margin: 0px; padding: 0px;">authentication&nbsp;</span><span style="margin: 0px; padding: 0px;">option</span><span style="margin: 0px; padding: 0px;">.</span></font></font></p>
<div>
<p><font face="times new roman,times" size="3">Following a successful ACE Portal login via email authentication,&nbsp;users&nbsp;now&nbsp;have the option to&nbsp;register a&nbsp;mobile&nbsp;phone number to receive&nbsp;a login security token&nbsp;via&nbsp;SMS.&nbsp;Following registration of a mobile phone number, users&nbsp;will&nbsp;have the&nbsp;option&nbsp;to&nbsp;select either&nbsp;the email or SMS&nbsp;method&nbsp;to receive the&nbsp;authentication token&nbsp;for future logins.&nbsp;Users&nbsp;can also&nbsp;edit or remove the phone number and notifications under the &ldquo;Manage Preferences&rdquo; feature.&nbsp;</font></p>
</div>
<div>
<p><font face="times new roman,times" size="3">For instructions on how to register and manage ACE Portal&nbsp;login authentication settings, review the&nbsp;related training guide on&nbsp;<a href="https://www.cbp.gov/trade/automated/training-and-reference-guides" target="_blank" rel="noopener">CBP&rsquo;s ACE Training webpage</a>.&nbsp;&nbsp;</font></p>
</div>
<div>
<p><font face="times new roman,times" size="3">Note:&nbsp;Use of the SMS authentication feature is optional.&nbsp;Message and data rates may apply.&nbsp;</font></p>
</div>
<div>
<p><font face="times new roman,times" size="3">For&nbsp;ACE Portal login&nbsp;assistance, contact&nbsp;<a href="mailto:ACE.Support@cbp.dhs.gov" target="_blank" rel="noopener">ACE.Support@cbp.dhs.gov</a>.&nbsp;&nbsp;</font></p>
</div>
</td>
</tr>
</tbody>
</table>
</div>
</div>
<!--[if (gte mso 9)|(IE)]>
  </td>
<![endif]--> <!--[if (gte mso 9)|(IE)]>
  </tr>
  </table>
<![endif]--></td>
</tr>
</tbody>
</table>
</div>
<!--[if (gte mso 9)|(IE)]>
      </td>
    </tr>
  </table>
<![endif]--></td>
<td style="-webkit-text-size-adjust: 100%; -ms-text-size-adjust: 100%; mso-table-lspace: 0pt; mso-table-rspace: 0pt;">&nbsp;</td>
</tr>
