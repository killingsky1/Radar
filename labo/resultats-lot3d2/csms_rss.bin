    <item>
      <pubDate>Mon, 28 Sep 2026 13:34:10 -0400</pubDate>
      <title>CSMS # 70050970 - Certain Canadian Products Excluded from Importation into the United States; Presidential Proclamations 11061, 11062, and 11063</title>
      <guid isPermaLink="false">70050970</guid>
      <link>https://content.govdelivery.com/accounts/USDHSCBP/bulletins/42ce49a</link>
