<!DOCTYPE html>  <html class="no-js" lang="fr" dir="ltr">    <head>      <meta charset="utf-8">      <!-- IW --><!--<iw_root><iw><iw_components><iw_component type="Page" display_name_eng="Page" display_name_fra="Page" vpath="//server/dfait-maeci/main/internet-internet/international/world-monde/WORKAREA/content-contenu/templatedata/pages-pages/generic-generique/data/international_relations-relations_internationales/sanctions/consolidated-consolide"/></iw_components></iw></iw_root>-->      <!-- Web Experience Toolkit (WET) / Boîte à outils de l'expérience Web (BOEW)        wet-boew.github.io/wet-boew/License-en.html / wet-boew.github.io/wet-boew/Licence-fr.html -->      <!-- WET v4.0.96.3 -->      <title>La Liste consolid&eacute;e des sanctions autonomes canadiennes</title>      <!-- Meta data begins -->      <meta content="width=device-width,initial-scale=1" name="viewport">      <meta name="description" content="La Liste consolid&eacute;e des sanctions autonomes canadiennes &eacute;num&egrave;re les noms des personnes physiques et des entit&eacute;s qui sont inscrites aux annexes des r&egrave;glements adopt&eacute;s en vertu de la Loi sur les mesures &eacute;conomiques sp&eacute;ciales (LMES) et de la Loi sur la justice pour les victimes de dirigeants &eacute;trangers corrompus (LJVDEC)." />      <meta name="dcterms.title" content="La Liste consolid&eacute;e des sanctions autonomes canadiennes" />      <meta name="dcterms:service" content="GAC-AMC_International" />      <meta name="dcterms.accessRights" content="2" />      <meta name="dcterms.creator" content="Affaires mondiales Canada" />      <meta name="dcterms.issued" title="W3CDTF" content="2015-10-19" />      <meta name="dcterms.modified" title="W3CDTF" content="2026-09-23" />      <meta name="dcterms.subject" title="scheme" content="Service diplomatique" />      <meta name="dcterms.language" title="ISO639-2/T" content="fra" />       <!-- REVIEW -->                <meta name="twitter:card" content="summary_lar