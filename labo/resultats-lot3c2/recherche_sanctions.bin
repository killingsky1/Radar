{"help": "https://open.canada.ca/data/api/3/action/help_show?name=package_search", "success": true, "result": {"count": 2, "facets": {}, "facet_ranges": {"portal_release_date": {"counts": ["1926-10-03T00:00:00Z", 2], "gap": "+100YEARS", "start": "1926-10-03T00:00:00Z", "end": "2126-10-03T00:00:00Z"}}, "facet_queries": {}, "results": [{"association_type": [], "audience": [], "author": null, "author_email": null, "collection": "primary", "contributor": {"en": "", "fr": ""}, "creator": "", "creator_user_id": "2dc5a12f-2a6f-4822-8514-165ea6bb05d9", "data_series_issue_identification": {"en": "", "fr": ""}, "data_series_name": {"en": "", "fr": ""}, "date_published": "2017-10-13 00:00:00", "digital_object_identifier": "OD-041", "display_flags": [], "frequency": "as_needed", "geographic_region": [], "id": "ab076f2e-94b1-4039-bb3d-58002deb826d", "imso_approval": "true", "isopen": false, "jurisdiction": "federal", "keywords": {"en": ["consolidated", "autonomous", "sanctions list"], "fr": ["consolid\u00e9e", "autonomes", "liste des sanctions"]}, "license_id": "ca-ogl-lgo", "license_title": "Open Government Licence - Canada", "license_url": "https://open.canada.ca/en/open-government-licence-canada", "maintainer": null, "maintainer_email": "opengovernment@international.gc.ca", "metadata_created": "2026-08-26T13:44:40.937050", "metadata_modified": "2026-08-26T13:44:40.989130", "name": "ab076f2e-94b1-4039-bb3d-58002deb826d", "notes": "Stored on Sphere, this is an ISL-managed spreadsheet shared with RDW periodically to provide back-end data for the website-based Consolidated Canadian Autonomous Sanctions List. This list contains all public-facing listing information for individuals, entities, and vessels, and is intended for reference only.", "notes_translated": {"en": "Stored on Sphere, this is an ISL-managed spreadsheet shared with RDW periodically to provide back-end data for the website-based Consolidated Canadian Autonomous Sanctions List. This list contains all public-facing listing information for individuals, entities, and vessels, and is intended for reference only.", "fr": "Enregistr\u00e9 sur Sphere, cette feuille de calcul g\u00e9r\u00e9e par ISL est partag\u00e9e p\u00e9riodiquement avec RDW afin de fournir les donn\u00e9es n\u00e9cessaires \u00e0 la Liste consolid\u00e9e des sanctions autonomes canadiennes accessible en ligne. Cette liste contient toutes les informations publiques concernant les personnes physiques, morales et les navires, et est fournie \u00e0 titre indicatif seulement."}, "num_resources": 3, "num_tags": 0, "org_section": {"en": "ISB", "fr": "ISB"}, "org_title_at_publication": {"en": "Global Affairs Canada", "fr": "Affaires mondiales Canada"}, "organization": {"id": "d7c2580f-89c5-4705-9d56-6b0e8e5d9538", "name": "dfatd-maecd", "title": "Global Affairs Canada | Affaires mondiales Canada", "type": "organization", "description": "", "image_url": "", "created": "2016-09-23T17:25:20.992093", "is_organization": true, "approval_status": "approved", "state": "active"}, "owner_org": "d7c2580f-89c5-4705-9d56-6b0e8e5d9538", "place_of_publication": [], "portal_release_date": "2026-08-26", "private": false, "program_page_url": {"en": "", "fr": ""}, "ready_to_publish": "true", "restrictions": "unrestricted", "spatial": "", "spatial_representation_type": [], "state": "active", "subject": ["economics_and_industry"], "title": "Consolidated Canadian Autonomous Sanctions List", "title_translated": {"en": "Consolidated Canadian Autonomous Sanctions List", "fr": "La Liste consolid\u00e9e des sanctions autonomes canadiennes"}, "topic_category": [], "type": "dataset", "url": null, "version": null, "resources": [{"cache_last_updated": null, "cache_url": null, "character_set": "", "created": "2026-08-26T13:44:40.982163", "data_quality": [], "datastore_active": false, "datastore_contains_all_records_of_source_file": false, "date_published": "2017-10-13", "description": "", "description_translated": {"en": "", "fr": ""}, "format": "XML", "hash": "", "id": "347ff56b-b0e3-4574-9d55-f90ed5e6e33e", "language": ["en", "fr"], "last_modified": null, "metadata_modified": "2026-08-26T13:44:40.927792", "mimetype": null, "mimetype_inner": null, "name": "Consolidated Canadian Autonomous Sanctions List", "name_translated": {"en": "Consolidated Canadian Autonomous Sanctions List", "fr": "La Liste consolid\u00e9e des sanctions autonomes canadiennes"}, "package_id": "ab076f2e-94b1-4039-bb3d-58002deb826d", "position": 0, "resource_type": "dataset", "state": "active", "unique_identifier": "", "url": "http://international.gc.ca/world-monde/assets/office_docs/international_relations-relations_internationales/sanctions/sema-lmes.xml", "url_type": "", "validation_status": "", "validation_timestamp": ""}, {"cache_last_updated": null, "cache_url": null, "character_set": "", "created": "2026-08-26T13:44:40.982169", "data_quality": [], "datastore_active": false, "datastore_contains_all_records_of_source_file": false, "date_published": "", "description": "", "description_translated": {"en": "", "fr": ""}, "format": "HTML", "hash": "", "id": "a8d2815e-848b-42a4-ba95-3eaffee700af", "language": ["en"], "last_modified": null, "metadata_modified": "2026-08-26T13:44:40.930796", "mimetype": null, "mimetype_inner": null, "name": "Consolidated Canadian Autonomous Sanctions List - 2026-08-19", "name_translated": {"en": "Consolidated Canadian Autonomous Sanctions List - 2026-08-19", "fr": "La Liste consolid\u00e9e des sanctions autonomes canadiennes - 2026-08-19"}, "package_id": "ab076f2e-94b1-4039-bb3d-58002deb826d", "position": 1, "resource_type": "website", "state": "active", "unique_identifier": "", "url": "https://www.international.gc.ca/world-monde/international_relations-relations_internationales/sanctions/consolidated-consolide.aspx?lang=eng", "url_type": "", "validation_status": "", "validation_timestamp": ""}, {"cache_last_updated": null, "cache_url": null, "character_set": "", "created": "2026-08-26T13:44:40.982171", "data_quality": [], "datastore_active": false, "datastore_contains_all_records_of_source_file": false, "date_published": "", "description": "", "description_translated": {"en": "", "fr": ""}, "format": "HTML", "hash": "", "id": "a8411c5b-5a58-4096-a325-59dea3e9d161", "language": ["fr"], "last_modified": null, "metadata_modified": "2026-08-26T13:44:40.933540", "mimetype": null, "mimetype_inner": null, "name": "Consolidated Canadian Autonomous Sanctions List - 2026-08-19", "name_translated": {"en": "Consolidated Canadian Autonomous Sanctions List - 2026-08-19", "fr": "La Liste consolid\u00e9e des sanctions autonomes canadiennes - 2026-08-19"}, "package_id": "ab076f2e-94b1-4039-bb3d-58002deb826d", "position": 2, "resource_type": "website", "state": "active", "unique_identifier": "", "url": "https://www.international.gc.ca/world-monde/international_relations-relations_internationales/sanctions/consolidated-consolide.aspx?lang=fra", "url_type": "", "validation_status": "", "validation_timestamp": ""}], "tags": [], "groups": [], "relationships_as_subject": [], "relationships_as_object": []}, {"additional_notes": {"en": "", "fr": ""}, "audience": [], "author": null, "author_email": null, "collection": "publication", "contributor": {"en": "", "fr": ""}, "creator": "", "creator_user_id": "2dc5a12f-2a6f-4822-8514-165ea6bb05d9", "data_series_issue_identification": {"en": "", "fr": ""}, "data_series_name": {"en": "", "fr": ""}, "date_published": "2025-03-01 00:00:00", "departmental_identification_number": "OI-1747", "digital_object_identifier": "", "edition": "", "frequency": "not_planned", "gc_catalogue_number": "", "geographic_region": [], "id": "023c70dc-692d-4e90-93e8-2ac19cf854be", "imso_approval": "true", "isbn": "", "isopen": false, "issn": "", "issuance": "", "issuance_frequency": "", "jurisdiction": "federal", "keywords": {"en": ["evaluation", "sanctions", "economic", "Russia", "Ukraine", "domestic regulatory program", "foreign policy tool", "corporate evaluation"], "fr": ["\u00c9valuation", "sanctions", "Russie", "Ukriane", "programme de r\u00e9glementation nationale", "instrument de politique \u00e9trang\u00e8re", "\u00e9valuations d'entreprise"]}, "license_id": "ca-ogl-lgo", "license_title": "Open Government Licence - Canada", "license_url": "https://open.canada.ca/en/open-government-licence-canada", "maintainer": null, "maintainer_email": "evaluation@international.gc.ca", "metadata_created": "2026-05-28T19:12:43.763314", "metadata_modified": "2026-09-01T16:52:02.315910", "name": "023c70dc-692d-4e90-93e8-2ac19cf854be", "notes": "Economic sanctions are a unique foreign policy tool implemented through domestic regulations. Canada implement multilateral sanctions as directed by the United Nations Security Council as well as its own autonomous sanctions.\r\n\r\nFrom 2018 to 2024, the sanctions landscape changed dramatically, which was not foreseen at the time that the Sanctions Policy and Operations Coordination Division (PER)* was first created. Prior to the Russian invasion of Ukraine in February 2022, sanctions were mostly applied to countries with which Canada had minimal economic relations. Sanctions have since become a preferred option and the exponential increase in sanctions packages has had an array of consequences for sanctions operations. It has also highlighted the tensions between sanctions as a domestic regulatory program and as a foreign policy tool.", "notes_translated": {"en": "Economic sanctions are a unique foreign policy tool implemented through domestic regulations. Canada implement multilateral sanctions as directed by the United Nations Security Council as well as its own autonomous sanctions.\r\n\r\nFrom 2018 to 2024, the sanctions landscape changed dramatically, which was not foreseen at the time that the Sanctions Policy and Operations Coordination Division (PER)* was first created. Prior to the Russian invasion of Ukraine in February 2022, sanctions were mostly applied to countries with which Canada had minimal economic relations. Sanctions have since become a preferred option and the exponential increase in sanctions packages has had an array of consequences for sanctions operations. It has also highlighted the tensions between sanctions as a domestic regulatory program and as a foreign policy tool.", "fr": "Les sanctions \u00e9conomiques constituent un outil particulier de politique \u00e9trang\u00e8re mis en \u0153uvre au moyen de notre r\u00e9glementation nationale. Le Canada impose des sanctions multilat\u00e9rales, conform\u00e9ment aux directives du Conseil de s\u00e9curit\u00e9 des Nations Unies, ainsi que ses propres sanctions autonomes.\r\n\r\nDe 2018 \u00e0 2024, le paysage des sanctions a radicalement chang\u00e9, ce qui n\u2019avait pas \u00e9t\u00e9 pr\u00e9vu lors de la cr\u00e9ation de la Direction de la coordination des politiques et des op\u00e9rations des sanctions (PER)*. Avant l\u2019invasion de l\u2019Ukraine par la Russie en f\u00e9vrier 2022, les sanctions \u00e9taient principalement appliqu\u00e9es \u00e0 des pays avec lesquels le Canada n\u2019entretenait que tr\u00e8s peu de relations \u00e9conomiques. Depuis, les sanctions sont devenues une option privil\u00e9gi\u00e9e et l\u2019augmentation exponentielle des ensembles de sanctions a eu une multitude de cons\u00e9quences sur ces activit\u00e9s. Cette situation a \u00e9galement mis en \u00e9vidence les tensions entre les sanctions comme programme de r\u00e9glementation nationale et comme instrument de politique \u00e9trang\u00e8re."}, "num_resources": 4, "num_tags": 0, "org_section": {"en": "RRD", "fr": "RRD"}, "org_title_at_publication": {"en": "Global Affairs Canada", "fr": "Affaires mondiales Canada"}, "organization": {"id": "d7c2580f-89c5-4705-9d56-6b0e8e5d9538", "name": "dfatd-maecd", "title": "Global Affairs Canada | Affaires mondiales Canada", "type": "organization", "description": "", "image_url": "", "created": "2016-09-23T17:25:20.992093", "is_organization": true, "approval_status": "approved", "state": "active"}, "owner_org": "d7c2580f-89c5-4705-9d56-6b0e8e5d9538", "place_of_publication": [], "portal_release_date": "2026-05-28", "private": false, "program_page_url": {"en": "", "fr": ""}, "pspc_identification_number": "", "ready_to_publish": "true", "restrictions": "unrestricted", "series_publication_dates": {"en": "", "fr": ""}, "spatial": "", "state": "active", "subject": ["economics_and_industry", "government_and_politics", "law", "military"], "title": "Evaluation of Global Affairs Canada\u2019s Sanctions Operations", "title_translated": {"en": "Evaluation of Global Affairs Canada\u2019s Sanctions Operations", "fr": "\u00c9valuation des op\u00e9rations de sanctions men\u00e9es par Affaires mondiales Canada"}, "type": "info", "url": null, "version": null, "resources": [{"cache_last_updated": null, "cache_url": null, "character_set": "", "created": "2026-05-28T19:12:43.958457", "datastore_active": false, "datastore_contains_all_records_of_source_file": false, "date_published": "", "description": null, "format": "HTML", "hash": "", "id": "ca4d9bec-4b1a-479a-ba9c-d8a2a892483c", "language": ["en"], "last_modified": null, "metadata_modified": "2026-09-01T16:52:02.308522", "mimetype": null, "mimetype_inner": null, "name": "Evaluation of Global Affairs Canada\u2019s Sanctions Operations, 2018-2024", "name_translated": {"en": "Evaluation of Global Affairs Canada\u2019s Sanctions Operations, 2018-2024", "fr": "\u00c9valuation des op\u00e9rations de sanctions men\u00e9es par Affaires mondiales Canada, 2018 \u00e0 2024"}, "package_id": "023c70dc-692d-4e90-93e8-2ac19cf854be", "position": 0, "resource_type": "report", "state": "active", "unique_identifier": "", "url": "https://international.canada.ca/en/global-affairs/corporate/transparency/evaluations/2025/sanctions-operations-report", "url_type": "", "validation_status": "", "validation_timestamp": ""}, {"cache_last_updated": null, "cache_url": null, "character_set": "", "created": "2026-05-28T19:12:43.958463", "datastore_active": false, "datastore_contains_all_records_of_source_file": false, "date_published": "", "description": null, "format": "HTML", "hash": "", "id": "fc23d687-cf10-4c3b-9fcf-ca0cd15bcea7", "language": ["fr"], "last_modified": null, "metadata_modified": "2026-09-01T16:52:02.308598", "mimetype": null, "mimetype_inner": null, "name": "Evaluation of Global Affairs Canada\u2019s Sanctions Operations, 2018-2024", "name_translated": {"en": "Evaluation of Global Affairs Canada\u2019s Sanctions Operations, 2018-2024", "fr": "\u00c9valuation des op\u00e9rations de sanctions men\u00e9es par Affaires mondiales Canada, 2018 \u00e0 2024"}, "package_id": "023c70dc-692d-4e90-93e8-2ac19cf854be", "position": 1, "resource_type": "report", "state": "active", "unique_identifier": "", "url": "https://international.canada.ca/fr/affaires-mondiales/organisation/transparence/evaluations/2025/operations-sanction-rapport", "url_type": "", "validation_status": "", "validation_timestamp": ""}, {"cache_last_updated": null, "cache_url": null, "character_set": "", "created": "2026-05-28T19:12:43.958465", "datastore_active": false, "datastore_contains_all_records_of_source_file": false, "date_published": "", "description": null, "format": "HTML", "hash": "", "id": "a68db2bf-00c2-40bd-bc93-1b28d6a0c814", "language": ["en"], "last_modified": null, "metadata_modified": "2026-09-01T16:52:02.308648", "mimetype": null, "mimetype_inner": null, "name": "Management Response and Action Plan (MRAP): Evaluation of Global Affairs Canada\u2019s Sanctions Operations, 2018-2024", "name_translated": {"en": "Management Response and Action Plan (MRAP): Evaluation of Global Affairs Canada\u2019s Sanctions Operations, 2018-2024", "fr": "R\u00e9ponse et plan d'action de la direction (RPAD) : \u00c9valuation des op\u00e9rations de sanction men\u00e9es par Affaires mondiales Canada, 2018-2024"}, "package_id": "023c70dc-692d-4e90-93e8-2ac19cf854be", "position": 2, "resource_type": "report", "state": "ac