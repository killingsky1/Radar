[{"Id":14071880,"NumberCode":"C-31","NumberPrefix":"C","Number":31,"LongTitleEn":"A second Act to implement certain provisions of the budget tabled in Parliament on November 4, 2025","LongTitleFr":"Loi no 2 portant exécution de certaines dispositions du budget déposé au Parlement le 4 novembre 2025","LongTitle":"Loi no 2 portant exécution de certaines dispositions du budget déposé au Parlement le 4 novembre 2025","ShortTitleEn":"Budget 2025 Implementation Act, No. 2","ShortTitleFr":"Loi no 2 d'exécution du budget de 2025","ShortTitle":"Loi no 2 d'exécution du budget de 2025","StatusId":352,"StatusNameEn":"At consideration in committee in the House of Commons","StatusNameFr":"À l'examen en comité à la Chambre des communes","StatusName":"À l'examen en comité à la Chambre des communes","LatestCompletedMajorStageId":60044,"LatestCompletedMajorStageNameEn":"Second reading","LatestCompletedMajorStageNameFr":"Deuxième lecture","LatestCompletedMajorStageName":"Deuxième lecture","LatestCompletedMajorStageNameWithChamberSuffix":"Deuxième lecture à la Chambre des communes","IsInSenatePreStudy":true,"LatestCompletedMajorStageChamberOrganizationId":1,"LatestCompletedMajorStageChamberNameEn":"House of Commons","LatestCompletedMajorStageChamberNameFr":"Chambre des communes","LatestCompletedMajorStageChamberName":"Chambre des communes","OngoingStageId":60038,"OngoingStageNameEn":"Senate pre-study","OngoingStageNameFr":"Étude préalable au Sénat","OngoingStageName":"Étude préalable au Sénat","LatestCompletedBillStageId":60030,"LatestCompletedBillStageNameEn":"Second reading","LatestCompletedBillStageNameFr":"Deuxième lecture","LatestCompletedBillStageName":"Deuxième lecture","LatestCompletedBillStageChamberOrganizationId":2,"LatestCompletedBillStageChamberNameEn":"Senate","LatestCompletedBillStageChamberNameFr":"Sénat","LatestCompletedBillStageChamberName":"Sénat","LatestCompletedBillStageDateTime":"2026-06-03T15:45:00","ParliamentNumber":45,"SessionNumber":1,"BillDocumentTypeId":3,"BillDocumentTypeNameEn":"House Government Bill","BillDocumentTypeNameFr":"Projet de loi émanant du gouvernement (Cdc)","BillDocumentTypeName":"Projet de loi émanant du gouvernement (Cdc)","IsGovernmentBill":true,"OriginatingChamberOrganizationId":1,"OriginatingChamberNameEn":"House of Commons","OriginatingChamberNameFr":"Chambre des communes","OriginatingChamberName":"Chambre des communes","IsHouseBill":true,"IsSenateBill":false,"SponsorSenateSystemAffiliationId":null,"SponsorPersonId":88633,"SponsorPersonOfficialFirstName":"François-Philippe","SponsorPersonOfficialLastName":"Champagne","SponsorPersonUsualFirstName":"","SponsorPersonMiddleName":"","SponsorPersonName":"François-Philippe Champagne","SponsorPersonShortHonorificEn":"Hon.","SponsorPersonShortHonorificFr":"L’hon.","SponsorPersonShortHonorific":"L’hon.","SponsorAffiliationTitleEn":"Minister of Finance and National Revenue","SponsorAffiliationTitleFr":"ministre des Finances et du Revenu national","SponsorAffiliationTitle":"ministre des Finances et du Revenu national","SponsorAffiliationRoleId":4,"SponsorAffiliationRoleNameEn":"Minister","SponsorAffiliationRoleNameFr":"ministre","SponsorAffiliationRoleName":"ministre","SponsorConstituencyId":1044,"SponsorConstituencyNameEn":"Saint-Maurice—Champlain","SponsorConstituencyNameFr":"Saint-Maurice—Champlain","SponsorConstituencyName":"Saint-Maurice—Champlain","LatestBillEventEventTypeId":60109,"LatestBillEventTypeNameEn":"Pre-study of House bill","LatestBillEventTypeNameFr":"Étude préalable d’un projet de loi émanant de la Chambre des communes","LatestBillEventStageId":60038,"LatestBillEventTypeName":"Étude préalable d’un projet de loi émanant de la Chambre des communes","LatestBillEventCommitteeDetails":{"BillDocumentId":0,"CommitteeOrganizationId":16101,"CommitteeNameEn":"Standing Senate Committee on National Finance","CommitteeNameFr":"Comité sénatorial permanent des finances nationales","CommitteeAcronym":"NFFN","CommitteeName":"Comité sénatorial permanent des finances nationales","StudyActivityId":null,"OrganizationTypeId":null,"ParentCommittee":null,"IsSubCommittee":false,"IsHouseOfCommonsCommittee":true,"IsSenateCommittee":false,"IsJointCommittee":false},"LatestBillEventDateTime":"2026-06-10T14:00:00","LatestBillEventChamberOrganizationId":2,"LatestBillEventChamberNameEn":"Senate","LatestBillEventChamberNameFr":"Sénat","LatestBillEventChamberName":"Sénat","LatestBillEventNumberOfAmendments":0,"LatestBillEventAmendmentNoteId":0,"LatestBillEventMeetingNumber":"81","LatestBillEventAdditionalInformationEn":"","LatestBillEventAdditionalInformationFr":"","LatestBillEventAdditionalInformation":"","PassedHouseFirstReadingDateTime":"2026-05-06T16:31:47.67","PassedHouseSecondReadingDateTime":"2026-06-03T15:45:00","PassedHouseThirdReadingDateTime":null,"PassedSenateFirstReadingDateTime":null,"PassedSenateSecondReadingDateTime":null,"PassedSenateThirdReadingDateTime":null,"ReceivedRoyalAssentDateTime":null,"DidReinstateFromPreviousSession":false,"ReinstatedFromBillDocumentId":null,"ReinstatedFromBillNumberCode":null,"DidReinstateInNextSession":false,"ReinstatedAsBillDocumentId":null,"ReinstatedAsBillNumberCode":null,"PassedFirstChamberFirstReading":true,"PassedFirstChamberSecondReading":true,"PassedFirstChamberThirdReading":false,"PassedSecondChamberFirstReading":false,"PassedSecondChamberSecondReading":false,"PassedSecondChamberThirdReading":false,"ReceivedRoyalAssent":false,"ConsideredDuringPreviousSitting":false,"IsProForma":false,"BillFormId":10,"BillFormNameEn":"Regular","BillFormNameFr":"Ordinaire","BillFormName":"Ordinaire","NotesEn":"<div><div>On Wednesday, June 10, 2026, the Senate adopted the following motion:<p></p>That, notwithstanding any provision of the Rules, previous order or usual practice:<p></p>1. in accordance with rule 10-11(1), the <a href=\"https://sencanada.ca/en/committees/nffn/45-1\">Standing Senate Committee on National Finance</a> be authorized to examine the subject matter of all of Bill C-31, A second Act to implement certain provisions of the budget tabled in Parliament on November 4, 2025, introduced in the House of Commons on May 6, 2026, in advance of the said bill coming before the Senate;\t</div><div><p></p>2.\tin addition, the following committees be separately authorized to examine the subject matter of the following elements contained in Bill C-31:<p></p>(a)\tthe <a href=\"https://sencanada.ca/en/committees/agfo/45-1\">Standing Senate Committee on Agriculture and Forestry</a>: those elements contained in Division 13 of Part 4;<p></p>\r\n(b)\tthe <a href=\"https://sencanada.ca/en/committees/banc/45-1\">Standing Senate Committee on Banking, Commerce and the Economy</a>: those elements contained in Divisions 1, 2, 3, 6, 7 and 8 of Part 4;<p></p>(c)\tthe  <a href=\"https://sencanada.ca/en/committees/aefa/45-1\">Standing Senate Committee on Foreign Affairs and International Trade</a>: those elements contained in Division 11 of Part 4;<p></p>(d)\tthe <a href=\"https://sencanada.ca/en/committees/ridr/45-1\">Standing Senate Committee on Human Rights</a>: those elements contained in Division 10 of Part 4;<p></p>(e)\tthe  <a href=\"https://sencanada.ca/en/committees/appa/45-1\">Standing Senate Committee on Indigenous Peoples</a>: those elements contained in Division 14 of Part 4;<p></p>(f)\tthe  <a href=\"https://sencanada.ca/en/committees/lcjc/45-1\">Standing Senate Committee on Legal and Constitutional Affairs</a>: those elements contained in Division 5 of Part 4;<p></p>(g)\tthe <a href=\"https://sencanada.ca/en/committees/secd/45-1\">Standing Senate Committee on National Security, Defence and Veterans Affairs</a>: those elements contained in Division 16 of Part 4;<p></p>(h)\tthe <a href=\"https://sencanada.ca/en/committees/secd/45-1\"></a><a href=\"https://sencanada.ca/en/committees/soci/45-1\">Standing Senate Committee on Social Affairs, Science and Technology</a>: those elements contained in Divisions 9 and 12 of Part 4; and<p></p>(i)\tthe<a href=\"https://sencanada.ca/en/committees/trcm/45-1\"> Standing Senate Committee on Transport and Communications</a>: those elements contained in Division 17 of Part 4;<p></p>3.\teach of the committees listed in point 2 that are authorized to examine the subject matter of particular elements of Bill C-31:<p></p>(a)\tsubmit its final report to the Senate no later than October 9, 2026; and<p></p>(b)\tbe authorized to deposit its report with the Clerk of the Senate if the Senate is not then sitting;<p></p>4.\tas the reports from the various committees authorized to examine the subject matter of particular elements of Bill C-31 are tabled in the Senate, they be placed on the Orders of the Day for consideration at the next sitting, provided that if a report is deposited with the Clerk, it be placed on the Orders of the Day for consideration at the next sitting following the one on which the depositing is recorded in the <i>Journals of the Senate</i>;<p></p>5.\tthe Standing Senate Committee on National Finance be authorized to take any reports tabled under point 3 into consideration during its study of the subject matter of all of Bill C-31; and<p></p>6.\tthe Standing Senate Committee on National Finance be authorized to deposit its report with the Clerk if the Senate is not then sitting; and<p></p>7.\tfor the purposes of this order, rule 12-18(2)(c)(ii) be understood as requiring the agreement of all leaders and facilitators, or their designates.</div><div></div></div>","NotesFr":"<div>Le mercredi 10 juin 2026, le Sénat a adopté la motion suivante :<p></p>Que, nonobstant toute disposition du Règlement, tout ordre antérieur ou toute pratique habituelle :<p></p>1.\tconformément à l’article 10-11(1) du Règlement, le <a href=\"https://sencanada.ca/fr/comites/nffn/45-1\">Comité sénatorial permanent des finances nationales</a> soit autorisé à étudier la teneur complète du projet de loi C-31, Loi n<sup>o</sup> 2 portant exécution de certaines dispositions du budget déposé au Parlement le 4 novembre 2025, déposé à la Chambre des communes le 6 mai 2026, avant que ce projet de loi soit soumis au Sénat;<p></p>2.\tde plus, les comités suivants soient individuellement autorisés à examiner la teneur des éléments suivants du projet de loi C-31 :<p></p>a)\tle <a href=\"https://sencanada.ca/fr/comites/agfo/45-1\">Comité sénatorial permanent de l’agriculture et des forêts</a> : les éléments de la section 13 de la partie 4;<p></p>b)\tle <a href=\"https://sencanada.ca/fr/comites/banc/45-1\">Comité sénatorial permanent des banques, du commerce et de l’économie</a> : les éléments des sections 1, 2, 3, 6, 7 et 8 de la partie 4;<p></p>c)\tle <a href=\"https://sencanada.ca/fr/comites/aefa/45-1\">Comité sénatorial permanent des affaires étrangères et du commerce international</a> : les éléments de la section 11 de la partie 4;<p></p>d)\tle <a href=\"https://sencanada.ca/fr/comites/ridr/45-1\">Comité sénatorial permanent des droits de la personne</a> : les éléments de la section 10 de la partie 4;<p></p>e)\tle <a href=\"https://sencanada.ca/fr/comites/appa/45-1\">Comité sénatorial permanent des peuples autochtones</a> : les éléments de la section 14 de la partie 4;<p></p>f)\tle <a href=\"https://sencanada.ca/fr/comites/lcjc/45-1\">Comité sénatorial permanent des affaires juridiques et constitutionnelles</a> : les éléments de la section 5 de la partie 4;<p></p>g)\tle <a href=\"https://sencanada.ca/fr/comites/secd/45-1\">Comité sénatorial permanent de la sécurité nationale, de la défense et des anciens combattants</a> : les éléments de la section 16 de la partie 4;<p></p>h)\tle <a href=\"https://sencanada.ca/fr/comites/soci/45-1\">Comité sénatorial permanent des affaires sociales, des sciences et de la technologie</a> : les éléments des sections 9 et 12 de la partie 4;<p></p>i)\tle <a href=\"https://sencanada.ca/fr/comites/trcm/45-1\">Comité sénatorial permanent des transports et des communications</a> : les éléments de la section 17 de la partie 4;<p></p>3.\tchacun des comités indiqués au point 2, qui sont autorisés à examiner la teneur de certains éléments du projet de loi C-31 :<p></p>a)\tsoumette son rapport final au Sénat au plus tard le 9 octobre 2026;<p></p>b)\tsoit autorisé à déposer son rapport auprès de la greffière du Sénat si le Sénat ne siège pas à ce moment-là;<p></p>4.\tau fur et à mesure que les rapports des comités autorisés à examiner la teneur d’éléments particuliers du projet de loi C-31 sont déposés au Sénat, ils soient inscrits à l’ordre du jour pour étude à la prochaine séance, à condition que si un rapport est déposé auprès de la greffière, l’étude de ce rapport soit inscrite à l’ordre du jour de la séance qui suit celle où le dépôt est consigné aux <i>Journaux du Sénat</i>;<p></p>5.\tle Comité sénatorial permanent des finances nationales soit autorisé à prendre en considération les rapports déposés conformément au point 3 au cours de son examen de la teneur complète du projet de loi C-31;<p></p>6.\tle Comité sénatorial permanent des finances nationales soit autorisé à déposer son rapport auprès de la greffière si le Sénat;<p></p>7. aux fins de cet ordre, l’article 12-18(2)c)(ii) soit interprété comme exigeant l’accord de tous les leaders et facilitateurs, ou de leurs délégués.</div>","Notes":"<div>Le mercredi 10 juin 2026, le Sénat a adopté la motion suivante :<p></p>Que, nonobstant toute disposition du Règlement, tout ordre antérieur ou toute pratique habituelle :<p></p>1.\tconformément à l’article 10-11(1) du Règlement, le <a href=\"https://sencanada.ca/fr/comites/nffn/45-1\">Comité sénatorial permanent des finances nationales</a> soit autorisé à étudier la teneur complète du projet de loi C-31, Loi n<sup>o</sup> 2 portant exécution de certaines dispositions du budget déposé au Parlement le 4 novembre 2025, déposé à la Chambre des communes le 6 mai 2026, avant que ce projet de loi soit soumis au Sénat;<p></p>2.\tde plus, les comités suivants soient individuellement autorisés à examiner la teneur des éléments suivants du projet de loi C-31 :<p></p>a)\tle <a href=\"https://sencanada.ca/fr/comites/agfo/45-1\">Comité sénatorial permanent de l’agriculture et des forêts</a> : les éléments de la section 13 de la partie 4;<p></p>b)\tle <a href=\"https://sencanada.ca/fr/comites/banc/45-1\">Comité sénatorial permanent des banques, du commerce et de l’économie</a> : les éléments des sections 1, 2, 3, 6, 7 et 8 de la partie 4;<p></p>c)\tle <a href=\"https://sencanada.ca/fr/comites/aefa/45-1\">Comité sénatorial permanent des affaires étrangères et du commerce international</a> : les éléments de la section 11 de la partie 4;<p></p>d)\tle <a href=\"https://sencanada.ca/fr/comites/ridr/45-1\">Comité sénatorial permanent des droits de la personne</a> : les éléments de la section 10 de la partie 4;<p></p>e)\tle <a href=\"https://sencanada.ca/fr/comites/appa/45-1\">Comité sénatorial permanent des peuples autochtones</a> : les éléments de la section 14 de la partie 4;<p></p>f)\tle <a href=\"https://sencanada.ca/fr/comites/lcjc/45-1\">Comité sénatorial permanent des affaires juridiques et constitutionnelles</a> : les éléments de la section 5 de la partie 4;<p></p>g)\tle <a href=\"https://sencanada.ca/fr/comites/secd/45-1\">Comité sénatorial permanent de la sécurité nationale, de la défense et des anciens combattants</a> : les éléments de la section 16 de la partie 4;<p></p>h)\tle <a href=\"https://sencanada.ca/fr/comites/soci/45-1\">Comité sénatorial permanent des affaires sociales, des sciences et de la technologie</a> : les éléments des sections 9 et 12 de la partie 4;<p></p>i)\tle <a href=\"https://sencanada.ca/fr/comites/trcm/45-1\">Comité sénatorial permanent des transports et des communications</a> : les éléments de la section 17 de la partie 4;<p></p>3.\tchacun des comités indiqués au point 2, qui sont autorisés à examiner la teneur de certains éléments du projet de loi C-31 :<p></p>a)\tsoumette son rapport final au Sénat au plus tard le 9 octobre 2026;<p></p>b)\tsoit autorisé à déposer son rapport auprès de la greffière du Sénat si le Sénat ne siège pas à ce moment-là;<p></p>4.\tau fur et à mesure que les rapports des comités autorisés à examiner la teneur d’éléments particuliers du projet de loi C-31 sont déposés au Sénat, ils soient inscrits à l’ordre du jour pour étude à la prochaine séance, à condition que si un rapport est déposé auprès de la greffière, l’étude de ce rapport soit inscrite à l’ordre du jour de la séance qui suit celle où le dépôt est consigné aux <i>Journaux du Sénat</i>;<p></p>5.\tle Comité sénatorial permanent des finances nationales soit autorisé à prendre en considération les rapports déposés conformément au point 3 au cours de son examen de la teneur complète du projet de loi C-31;<p></p>6.\tle Comité sénatorial permanent des finances nationales soit autorisé à déposer son rapport auprès de la greffière si le Sénat;<p></p>7. aux fins de cet ordre, l’article 12-18(2)c)(ii) soit interprété comme exigeant l’accord de tous les leaders et facilitateurs, ou de leurs délégués.</div>","ShortLegislativeSummaryEn":"","ShortLegislativeSummaryFr":"","ShortLegislativeSummary":"","IsFullLegislativeSummaryAvailable":true,"StatuteYear":null,"StatuteChapter":null,"BillStages":{"BillId":0,"HouseBillStages":[{"BillStageId":60029,"BillStageNameEn":"First reading","BillStageNameFr":"Première lecture","BillStageName":"Première lecture","ChamberOrganizationId":1,"ParliamentNumber":45,"SessionNumber":1,"State":4,"StateNameEn":"Completed","StateNameFr":"Terminée","StateAsOfDate":"2026-05-06T16:31:47.67","StateName":"Terminée","Committee":null,"Sittings":[{"NameEn":"Introduction and first reading","NameFr":"Dépôt et première lecture","Name":"Dépôt et première lecture","Number":"118","Date":"2026-05-06T00:00:00","AdditionalInformationEn":null,"AdditionalInformationFr":null,"AdditionalInformation":null,"IsPublished":true}],"Decisions":[],"CommitteeMeetings":[],"SignificantEvents":[{"EventTypeId":60110,"BillDocumentId":0,"EventNameEn":"Introduct