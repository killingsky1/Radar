<div class="visible-xs">
  <section class="container">
    <h1 id="wb-cont">Bureau des grands projets</h1>
    <p>Réaliser de grands projets qui transformeront et relieront l’économie canadienne.</p>
    <div>&nbsp;</div>
  </section>
</div>


</div>
<div class="mwsmediaplayer section">

    <div>
  <nav>
    <div style="background: #234c46; padding: 1px;" class="visible-lg">
