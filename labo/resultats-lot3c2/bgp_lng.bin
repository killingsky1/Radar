      </div>

      <div class="col-md-4 hght-inhrt">
        <div class="eqht-trgt hght-inhrt" style="background-color: #4a6963; color: white; padding: 5px">
          <h2 class="h4" style="margin-top: 0px; margin-bottom: 0px">Location</h2>
