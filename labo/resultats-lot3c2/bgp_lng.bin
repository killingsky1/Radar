      <h1 property="name" style="margin-bottom: 0px; margin-top: 0px">LNG Canada Phase 2</h1>
     
  </div>
	</div></div>

</div>
<div class="mwsmediaplayer section">

    <div style="background-color: #4a6963" class="visible-md visible-lg">
  <section class="container gc-features">
