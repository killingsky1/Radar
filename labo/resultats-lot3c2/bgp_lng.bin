        <div class="eqht-trgt hght-inhrt" style="background-color: #4a6963; color: white; padding: 5px; border-right: 1px white solid">
          <h2 class="h4" style="margin-top: 0px; margin-bottom: 0px">Sector</h2>
          <p style="line-height: 1.2;">Energy</p>
