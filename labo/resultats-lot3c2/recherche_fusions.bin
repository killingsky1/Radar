{"help": "https://open.canada.ca/data/api/3/action/help_show?name=package_search", "success": true, "result": {"count": 2, "facets": {}, "facet_ranges": {"portal_release_date": {"counts": ["1926-10-03T00:00:00Z", 2], "gap": "+100YEARS", "start": "1926-10-03T00:00:00Z", "end": "2126-10-03T00:00:00Z"}}, "facet_queries": {}, "results": [{"association_type": [], "audience": [], "author": null, "author_email": null, "collection": "primary", "contributor": {"fr": "", "en": ""}, "creator": "Mergers Intelligence and Notification Unit", "creator_user_id": "2dc5a12f-2a6f-4822-8514-165ea6bb05d9", "data_series_issue_identification": {"fr": "", "en": ""}, "data_series_name": {"fr": "", "en": ""}, "date_published": "2023-07-10 00:00:00", "digital_object_identifier": "", "display_flags": [], "frequency": "P3M", "geographic_region": ["0"], "id": "c85cc13e-c571-4b02-845c-897e8e63db4d", "imso_approval": "true", "isopen": false, "jurisdiction": "federal", "keywords": {"fr": ["fusions"], "en": ["merger"]}, "license_id": "ca-ogl-lgo", "license_title": "Open Government Licence - Canada", "license_url": "https://open.canada.ca/en/open-government-licence-canada", "maintainer": null, "maintainer_contact_form": {}, "maintainer_email": "alex.sarabura@cb-bc.gc.ca", "metadata_contact": {}, "metadata_created": "2023-07-11T16:11:45.467673", "metadata_modified": "2023-07-11T16:11:45.467681", "name": "c85cc13e-c571-4b02-845c-897e8e63db4d", "notes": "Monthly report of concluded merger reviews\r\nList of concluded Merger Reviews where a pre-merger notification was made under section 114 of the Competition Act (\"Act\") and/or a request was made for an advance ruling certificate under section 102 of the Act. The list is updated on or after the 10th calendar day of each month for merger reviews completed during the previous month.", "notes_translated": {"fr": "Rapport mensuel des examens des fusions termin\u00e9s\r\nListe des examens des fusions termin\u00e9s pour lesquels un pr\u00e9avis de fusion a \u00e9t\u00e9 d\u00e9pos\u00e9 conform\u00e9ment \u00e0 l'article 114 de la Loi sur la concurrence (la \u00ab Loi \u00bb) ou une demande de certificat de d\u00e9cision pr\u00e9alable a \u00e9t\u00e9 faite en vertu de l'article 102 de la Loi. Cette liste est mise \u00e0 jour le 10e jour civil de chaque mois ou apr\u00e8s pour les examens de fusion termin\u00e9s le mois pr\u00e9c\u00e9dent.", "en": "Monthly report of concluded merger reviews\r\nList of concluded Merger Reviews where a pre-merger notification was made under section 114 of the Competition Act (\"Act\") and/or a request was made for an advance ruling certificate under section 102 of the Act. The list is updated on or after the 10th calendar day of each month for merger reviews completed during the previous month."}, "num_resources": 2, "num_tags": 0, "org_section": {"fr": "Bureau de la concurrence", "en": "Competition Bureau"}, "org_title_at_publication": {"fr": "Innovation, Science and Economic Development Canada", "en": "Innovation, Science and Economic Development Canada"}, "organization": {"id": "06CC519C-E56E-4FC8-8B9C-BE0A461E3CD9", "name": "ic", "title": "Innovation, Science and Economic Development Canada | Innovation, Sciences et D\u00e9veloppement \u00e9conomique Canada", "type": "organization", "description": "", "image_url": "", "created": "2016-09-23T17:25:34.649223", "is_organization": true, "approval_status": "approved", "state": "active"}, "owner_org": "06CC519C-E56E-4FC8-8B9C-BE0A461E3CD9", "place_of_publication": ["0"], "portal_release_date": "2023-07-11", "position_name": {}, "private": false, "program_page_url": {"fr": "https://ised-isde.canada.ca/site/bureau-concurrence-canada/fr/fusions-acquisitions/rapport-mensuel-examens-fusions-termines", "en": "https://ised-isde.canada.ca/site/competition-bureau-canada/en/mergers-and-acquisitions/monthly-report-concluded-merger-reviews"}, "ready_to_publish": "true", "restrictions": "unrestricted", "spatial": "", "spatial_representation_type": [], "state": "active", "subject": ["economics_and_industry"], "time_period_coverage_end": "2023-06-30 00:00:00", "time_period_coverage_start": "2015-01-31 00:00:00", "title": "Monthly report of concluded merger reviews", "title_translated": {"fr": "Rapport mensuel des examens des fusions termin\u00e9s", "en": "Monthly report of concluded merger reviews"}, "topic_category": [], "type": "dataset", "url": null, "version": null, "resources": [{"cache_last_updated": null, "cache_url": null, "character_set": "", "created": "2023-07-11T16:11:45.563748", "data_quality": [], "datastore_active": false, "datastore_contains_all_records_of_source_file": false, "date_published": "", "description": "", "format": "HTML", "hash": "", "id": "85eda547-9cf0-4dfb-9a89-07913f863f96", "language": ["en"], "last_modified": null, "metadata_modified": "2023-07-11T16:11:45.563748", "mimetype": null, "mimetype_inner": null, "name": "Monthly report of concluded merger reviews", "name_translated": {"fr": "Rapport mensuel des examens des fusions termin\u00e9s", "en": "Monthly report of concluded merger reviews"}, "package_id": "c85cc13e-c571-4b02-845c-897e8e63db4d", "position": 0, "resource_type": "website", "state": "active", "unique_identifier": "", "url": "https://ised-isde.canada.ca/site/competition-bureau-canada/en/mergers-and-acquisitions/monthly-report-concluded-merger-reviews", "url_type": null, "validation_status": "", "validation_timestamp": ""}, {"cache_last_updated": null, "cache_url": null, "character_set": "", "created": "2023-07-11T16:11:45.563756", "data_quality": [], "datastore_active": false, "datastore_contains_all_records_of_source_file": false, "date_published": "", "description": "", "format": "HTML", "hash": "", "id": "c3a3026b-b575-4015-b364-b27b68cb70e4", "language": ["fr"], "last_modified": null, "metadata_modified": "2023-07-11T16:11:45.563756", "mimetype": null, "mimetype_inner": null, "name": "Monthly report of concluded merger reviews", "name_translated": {"fr": "Rapport mensuel des examens des fusions termin\u00e9s", "en": "Monthly report of concluded merger reviews"}, "package_id": "c85cc13e-c571-4b02-845c-897e8e63db4d", "position": 1, "related_relationship": null, "related_type": null, "resource_type": "website", "state": "active", "unique_identifier": "", "url": "https://ised-isde.canada.ca/site/bureau-concurrence-canada/fr/fusions-acquisitions/rapport-mensuel-examens-fusions-termines", "url_type": null, "validation_status": "", "validation_timestamp": ""}], "tags": [], "groups": [], "relationships_as_subject": [], "relationships_as_object": []}, {"additional_notes": {"en": "", "fr": ""}, "audience": [], "author": null, "author_email": null, "collection": "publication", "contributor": {"en": "", "fr": ""}, "creator": "", "creator_user_id": "2dc5a12f-2a6f-4822-8514-165ea6bb05d9", "data_series_issue_identification": {"en": "", "fr": ""}, "data_series_name": {"en": "", "fr": ""}, "date_published": "2011-01-01 00:00:00", "departmental_identification_number": "OI-2052", "digital_object_identifier": "", "edition": "", "frequency": "not_planned", "gc_catalogue_number": "", "geographic_region": [], "id": "a44e5ca0-b147-4d97-86b9-c40729b6952d", "imso_approval": "true", "isbn": "", "isopen": false, "issn": "", "issuance": "", "issuance_frequency": "", "jurisdiction": "federal", "keywords": {"en": ["audit", "audit of", "passport canada"], "fr": ["audit", "audit de", "passeport Canada"]}, "license_id": "ca-ogl-lgo", "license_title": "Open Government Licence - Canada", "license_url": "https://open.canada.ca/en/open-government-licence-canada", "maintainer": null, "maintainer_email": "vbs@international.gc.ca", "metadata_created": "2026-09-03T19:16:55.383145", "metadata_modified": "2026-09-03T19:16:55.439393", "name": "a44e5ca0-b147-4d97-86b9-c40729b6952d", "notes": "Global Affairs Canada uses the audit process as an important way to ensure the efficient use of public funds. The Office of the Chief Audit Executive leads this work by reviewing and assessing management practices and controls. Once the audit engagement is complete, the audit team recommends areas of improvement throughout the department.\r\n\r\nGlobal Affairs Canada regularly performs internal audits of its foreign affairs, international development and trade programs. The department then follows a diligent process to respond to all audit findings. This includes following up on detailed management action plans to specifically address any gaps or issues identified by the audits.\r\n\r\nThese action plans ensure that recommendations are implemented and that risks are mitigated. Ultimately, they provide guidance on appropriate oversight and effective use of public funds so that Global Affairs Canada\u2019s programs and activities in Canada and in missions around the world are delivered diligently. In addition, the Office of the Chief Audit Executive provides regular guidance and follow-up to the department throughout the year to ensure progress is being made on the action plans.", "notes_translated": {"en": "Global Affairs Canada uses the audit process as an important way to ensure the efficient use of public funds. The Office of the Chief Audit Executive leads this work by reviewing and assessing management practices and controls. Once the audit engagement is complete, the audit team recommends areas of improvement throughout the department.\r\n\r\nGlobal Affairs Canada regularly performs internal audits of its foreign affairs, international development and trade programs. The department then follows a diligent process to respond to all audit findings. This includes following up on detailed management action plans to specifically address any gaps or issues identified by the audits.\r\n\r\nThese action plans ensure that recommendations are implemented and that risks are mitigated. Ultimately, they provide guidance on appropriate oversight and effective use of public funds so that Global Affairs Canada\u2019s programs and activities in Canada and in missions around the world are delivered diligently. In addition, the Office of the Chief Audit Executive provides regular guidance and follow-up to the department throughout the year to ensure progress is being made on the action plans.", "fr": "Pour Affaires mondiales Canada, le processus d\u2019audit est un moyen important de veiller \u00e0 l\u2019utilisation efficiente des fonds publics. Le Bureau du dirigeant principal de l\u2019audit dirige ces travaux en examinant et en \u00e9valuant les pratiques et les contr\u00f4les de gestion. Une fois la mission d\u2019audit termin\u00e9e, l\u2019\u00e9quipe responsable de l\u2019audit recommande des points \u00e0 am\u00e9liorer pour l\u2019ensemble du Minist\u00e8re.\r\n\r\nAffaires mondiales Canada effectue r\u00e9guli\u00e8rement d\u2019audits internes de ses programmes relatifs aux affaires \u00e9trang\u00e8res, au d\u00e9veloppement international et au commerce international. Le Minist\u00e8re suit ensuite un processus rigoureux pour r\u00e9pondre \u00e0 toutes les conclusions d\u2019audits. Il effectue entre autres un suivi des plans d\u2019action d\u00e9taill\u00e9s \u00e9labor\u00e9s par la direction pour combler chacune des lacunes relev\u00e9es dans les audits.\r\n\r\nCes plans d\u2019action visent \u00e0 assurer la mise en \u0153uvre des recommandations et l\u2019att\u00e9nuation des risques. Ultimement, ils fournissent une orientation quant \u00e0 la surveillance ad\u00e9quate et \u00e0 l\u2019utilisation efficiente des fonds publics afin que les programmes et les activit\u00e9s d\u2019Affaires mondiales Canada, au Canada et dans les missions partout dans le monde, soient ex\u00e9cut\u00e9s avec assiduit\u00e9. En outre, le Bureau du dirigeant principal de l\u2019audit oriente le Minist\u00e8re et effectue un suivi aupr\u00e8s de lui tout au long de l\u2019ann\u00e9e pour assurer la progression ad\u00e9quate de la mise en \u0153uvre des plans d\u2019action."}, "num_resources": 2, "num_tags": 0, "org_section": {"en": "VBS", "fr": "VBS"}, "org_title_at_publication": {"en": "Global Affairs Canada", "fr": "Affaires mondiales Canada"}, "organization": {"id": "d7c2580f-89c5-4705-9d56-6b0e8e5d9538", "name": "dfatd-maecd", "title": "Global Affairs Canada | Affaires mondiales Canada", "type": "organization", "description": "", "image_url": "", "created": "2016-09-23T17:25:20.992093", "is_organization": true, "approval_status": "approved", "state": "active"}, "owner_org": "d7c2580f-89c5-4705-9d56-6b0e8e5d9538", "place_of_publication": [], "portal_release_date": "2026-09-03", "private": false, "program_page_url": {"en": "", "fr": ""}, "pspc_identification_number": "", "ready_to_publish": "true", "restrictions": "unrestricted", "series_publication_dates": {"en": "", "fr": ""}, "spatial": "", "state": "active", "subject": ["government_and_politics"], "title": "Review of Passport Canada's Competitive Acquisition Process", "title_translated": {"en": "Review of Passport Canada's Competitive Acquisition Process", "fr": "Examen du processus d'acquisition par appel d'offres concurrentiel de passeport Canada"}, "type": "info", "url": null, "version": null, "resources": [{"cache_last_updated": null, "cache_url": null, "character_set": "", "created": "2026-09-03T19:16:55.433576", "datastore_active": false, "datastore_contains_all_records_of_source_file": false, "date_published": "", "description": "", "description_translated": {"en": "", "fr": ""}, "format": "HTML", "hash": "", "id": "07ae7e89-5a93-4afb-90b1-4cdf29258d9a", "language": ["en"], "last_modified": null, "metadata_modified": "2026-09-03T19:16:55.376900", "mimetype": null, "mimetype_inner": null, "name": "Review of Passport Canada's Competitive Acquisition Process - 2011-01-01", "name_translated": {"en": "Review of Passport Canada's Competitive Acquisition Process - 2011-01-01", "fr": "Examen du processus d'acquisition par appel d'offres concurrentiel de passeport Canada -  2011-01-01"}, "package_id": "a44e5ca0-b147-4d97-86b9-c40729b6952d", "position": 0, "resource_type": "audit", "state": "active", "unique_identifier": "", "url": "https://webarchiveweb.wayback.bac-lac.canada.ca/web/20250611144051/https://www.international.gc.ca/gac-amc/publications/audits-verification/2011/pca_pocp11.aspx?lang=eng", "url_type": "", "validation_status": "", "validation_timestamp": ""}, {"cache_last_updated": null, "cache_url": null, "character_set": "", "created": "2026-09-03T19:16:55.433583", "datastore_active": false, "datastore_contains_all_records_of_source_file": false, "date_published": "", "description": "", "description_translated": {"en": "", "fr": ""}, "format": "HTML", "hash": "", "id": "e0a89aef-8538-427c-9e88-38cc82db1f01", "language": ["fr"], "last_modified": null, "metadata_modified": "2026-09-03T19:16:55.379788", "mimetype": null, "mimetype_inner": null, "name": "Review of Passport Canada's Competitive Acquisition Process - 2011-01-01", "name_translated": {"en": "Review of Passport Canada's Competitive Acquisition Process - 2011-01-01", "fr": "Examen du processus d'acquisition par appel d'offres concurrentiel de passeport Canada -  2011-01-01"}, "package_id": "a44e5ca0-b147-4d97-86b9-c40729b6952d", "position": 1, "resource_type": "audit", "state": "active", "unique_identifier": "", "url": "https://webarchiveweb.wayback.bac-lac.canada.ca/web/20250611144051/https://www.international.gc.ca/gac-amc/publications/audits-verification/2011/pca_pocp11.aspx?lang=fra", "url_type": "", "validation_status": "", "validation_timestamp": ""}], "tags": [], "groups": [], "relationships_as_subject": [], "relationships_as_object": []}], "sort": "score desc, metadata_modified desc", "search_facets": {}}}