<body text="#000000" bgcolor="#FFFFFF" onload="on();$(document).ready(function () {    /*     * Internal pages must use the API on the internal Domino server.     * Production and all other hosts must use extapps2.     */    var hostname = window.location.hostname.toLowerCase();    var isInternal =        hostname === &quot;intpriaps02.oge.gov&quot; ||        hostname === &quot;intpriaps02&quot; ||        hostname.indexOf(&quot;intpriaps02.&quot;) === 0;    var apiUrl;    if (isInternal) {        apiUrl =            &quot;/201/Presiden.nsf/API.xsp/v3/rest&quot;;    } else {        apiUrl =            &quot;https://extapps2.oge.gov/201/Presiden.nsf/API.xsp/v3/rest&quot;;    }    console.log(        &quot;Loading disclosure data from: &quot; + apiUrl    );    var table = $(&quot;#example&quot;).DataTable({        &quot;pageLength&quot;: 100,        &quot;serverSide&quot;: true,        &quot;processing&quot;: true,        &quot;deferRender&quot;: true,        &quot;layout&quot;: {            &quot;topEnd&quot;: &quot;&quot;,            &quot;bottomStart&quot;: &quot;info&quot;,            &quot;bottomEnd&quot;: &quot;paging&quot;        },        &quot;columnDefs&quot;: [            {                &quot;type&quot;: &quot;date&quot;,                &quot;targets&quot;: 0            }        ],        &quot;order&quot;: [            [0, &quot;desc&quot;]        ],        &quot;language&quot;: {            &quot;infoFiltered&quot;:                &quot;&lt;span class='quickApproveTable_info_filtered_span'&gt;&quot; +                &quot;(filtered from _MAX_ total entries)&quot; +                &quot;&lt;/span&gt;&quot;,            &quot;emptyTable&quot;:                &quot;No matching records found&quot;,            &quot;loadingRecords&quot;:                &quot;Loading disclosure records...&quot;,            &quot;processing&quot;:                &quot;Loading disclosure records...&quot;        },        &quot;ajax&quot;: {            &quot;url&quot;: apiUrl,            &quot;type&quot;: &quot;GET&quot;,            &quot;dataSrc&quot;: &quot;data&quot;        },        &quot;columns&quot;: [            {                &quot;data&quot;: &quot;docDate&quot;,                &quot;title&quot;: &quot;Date Added&quot;,                &quot;render&quot;: function (                    data,                    type,                    row,                    meta                ) {                    var rtn = &quot;&quot;;                    if (type === &quot;display&quot;) {                        var date = new Date(data);                        var month =                            date.getMonth() + 1;                        var monthStr = &quot;&quot;;                        if (                            month.toString().length &gt; 1                        ) {                            monthStr = month;                        } else {                            monthStr = &quot;0&quot; + month;                        }                        rtn =                            monthStr +                            &quot;/&quot; +                            date.getDate() +                            &quot;/&quot; +                            date.getFullYear();                    } else {                        rtn = data;                    }                    return rtn;                }            },            {                &quot;data&quot;: &quot;title&quot;,                &quot;title&quot;: &quot;Title&quot;            },            {                &quot;data&quot;: &quot;type&quot;,                &quot;title&quot;: &quot;Type&quot;,                &quot;render&quot;: function (                    data,                    type,                    row,                    meta                ) {                    return data;                }            },            {                &quot;data&quot;: &quot;name&quot;,                &quot;title&quot;: &quot;Name&quot;            },            {                &quot;data&quot;: &quot;agency&quot;,                &quot;title&quot;: &quot;Agency&quot;            },            {                &quot;data&quot;: &quot;level&quot;,                &quot;title&quot;: &quot;Level&quot;            }        ]    });    /*     * Add one filter input beneath each table heading.     */    var tableHead =        document.querySelector(&quot;#example thead&quot;);    var titleRow =        tableHead.querySelector(&quot;tr&quot;);    var filterRow =        document.createElement(&quot;tr&quot;);    var titleCells =        titleRow.querySelectorAll(&quot;th&quot;);    filterRow.className = &quot;column-filter-row&quot;;    titleCells.forEach(function (        titleCell,        columnIndex    ) {        var title =            titleCell.innerText;        var filterCell =            document.createElement(&quot;th&quot;);        var input =            document.createElement(&quot;input&quot;);        input.type = &quot;text&quot;;        input.placeholder =            &quot;Filter &quot; + title;        input.setAttribute(            &quot;aria-label&quot;,            &quot;Filter by &quot; + title        );        var listener = function () {            var searchValue = this.value;            /*             * Dates are displayed as MM/DD/YYYY, while V3             * searches them as YYYY-MM-DD. Convert a complete             * date before sending it to the API.             */            if (columnIndex === 0) {                var dateMatch =                    searchValue.match(                        /^(\d{1,2})\/(\d{1,2})\/(\d{4})$/                    );                if (dateMatch) {                    var month =                        dateMatch[1];                    if (month.length === 1) {                        month = &quot;0&quot; + month;                    }                    var day =                        dateMatch[2];                    if (day.length === 1) {                        day = &quot;0&quot; + day;                    }                    var year =                        dateMatch[3];                    searchValue =                        year +                        &quot;-&quot; +                        month +                        &quot;-&quot; +                        day;                }            }            if (                table                    .column(columnIndex)                    .search() !== searchValue            ) {                table                    .column(columnIndex)                    .search(searchValue)                    .draw();            }        };        input.addEventListener(            &quot;keyup&quot;,            listener        );        input.addEventListener(            &quot;change&quot;,            listener        );        filterCell.appendChild(input);        filterRow.appendChild(filterCell);    });    tableHead.appendChild(filterRow);});">

