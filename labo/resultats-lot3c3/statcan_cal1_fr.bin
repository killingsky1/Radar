				monthNames: [ "janvier", "f&#233;vrier", "mars", "avril", "mai", "juin", "juillet", "ao&#251;t", "septembre", "octobre", "novembre", "d&#233;cembre" ],
				dayNamesShort: [ 'Dim','Lun','Mar','Mer', 'Jeu','Ven','Sam' ],
				txt_noEvents: "Il n'y a pas de communiqu&#233;s pour cette p&#233;riode",
				txt_SpecificEvents_prev: "communiqu&#233;(s) pour ",
				txt_SpecificEvents_after: "",
				txt_next: "Mois suivant ",
				txt_prev: "Mois pr&#233;c&#233;dant",
				txt_NextEvents: "Prochains communiqu&#233;s :",	
				eventsjson: '/dai-quo/ssi/homepage/schedule-key_indicators-fra.json', // link to events json
				dateFormat: 'dddd, YYYY-MM-DD',
				showDescription: 'true',
				eventsLimit: 500,		
				startWeekOnMonday: false,
				jsonDateFormat: 'human'
			});
		});
        $("#select_month").change(function() {
				ZeFlag = 1;
        });
        $("#select_year").change(function() {
				ZeFlag = 1;
        });
</script>
</body>
</html>
