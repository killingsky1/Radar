<script>
$.extend( $.fn.dataTable.defaults, {
    pageLength: 100
});



var popoverTriggerList = [].slice.call(document.querySelectorAll('[data-bs-toggle="popover"]'))
var popoverList = popoverTriggerList.map(function (popoverTriggerEl) {
  return new bootstrap.Popover(popoverTriggerEl)
})

document.addEventListener("DOMContentLoaded", function () {
        const triggers = document.querySelectorAll('[rel="popover"]');
        triggers.forEach(el => bootstrap.Popover.getOrCreateInstance(el));
        document.addEventListener('click', function (e) {
                const popover = document.querySelector('.popover');

                triggers.forEach(trigger => {
                        const instance = bootstrap.Popover.getInstance(trigger);
                        const isClickInside =
                                trigger.contains(e.target) ||
                                (popover && popover.contains(e.target));

                        if (instance && !isClickInside) {
                                instance.hide();
                        }
                });
        });
});
</script>
